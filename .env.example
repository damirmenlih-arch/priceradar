# ============================================================
# PriceRadar — конфигурация окружения
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ============================================================

# --- Обязательно ---
# Токен бота от @BotFather
BOT_TOKEN=

# --- База данных ---
# Локально по умолчанию SQLite (файл priceradar.db рядом с .env).
# В docker-compose DB_DSN переопределяется на PostgreSQL (см. environment в docker-compose.yml).
DB_DSN=sqlite+aiosqlite:///./priceradar.db

# --- Redis (необязательно) ---
# Пусто  -> FSM в памяти (MemoryStorage), anti-spam/throttling выключен. Достаточно для локального запуска.
# Заполнено -> RedisStorage + throttling (как в docker).
# REDIS_DSN=redis://localhost:6379/0

# --- Поведение ---
# Интервал фоновой проверки цен APScheduler'ом, минут
CHECK_INTERVAL_MINUTES=60

# Парсер: размер батча и максимальная параллельность HTTP-запросов
PARSE_BATCH_SIZE=50
PARSE_CONCURRENCY=10

# Throttling бота (работает только при заданном REDIS_DSN)
THROTTLE_RATE=3
THROTTLE_WINDOW_S=2
